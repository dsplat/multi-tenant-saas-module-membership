{
  "name": "dsplat/multi-tenant-saas-module-membership",
  "description": "会员体系 - 会员等级/积分规则/会员卡（通用会员底座，积分商品兑换编排留在项目层）",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "MultiTenantSaas\\Modules\\Membership\\": ""
